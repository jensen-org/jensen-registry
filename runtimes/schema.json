{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jensen-org/jensen-registry/runtimes/schema.json",
  "title": "Jensen registry runtimes",
  "description": "Entry files under runtimes/ and the runtime items of index.yaml: where a runtime keeps the model gateway it talks to.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 80
    },
    "keyPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
      "maxLength": 200
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "format", "base_url", "token", "models_path", "model_env"],
      "properties": {
        "file": {
          "type": "string",
          "description": "Relative to the user's home folder, with no leading slash and no ..",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": { "pattern": "(^|/)\\.\\.(/|$)" },
          "maxLength": 200
        },
        "format": { "enum": ["json", "toml"] },
        "base_url": { "$ref": "#/$defs/keyPath" },
        "token": { "$ref": "#/$defs/keyPath" },
        "models_path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9/_.-]*$",
          "not": { "pattern": "\\.\\." },
          "maxLength": 200
        },
        "model_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64 },
        "auth_header": { "type": "string", "pattern": "^[A-Za-z0-9-]+$", "maxLength": 64 },
        "auth_scheme": { "type": "string", "pattern": "^[A-Za-z0-9]+$", "maxLength": 32 }
      }
    },
    "runtimeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gateway"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "gateway": { "$ref": "#/$defs/gateway" }
      }
    },
    "indexRuntime": {
      "$ref": "#/$defs/runtimeEntry"
    }
  }
}
