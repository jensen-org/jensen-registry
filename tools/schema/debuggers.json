{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jensen-org/jensen-registry/tools/schema/debuggers.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "upstream", "debuggers"],
  "properties": {
    "schema_version": { "const": 2 },
    "upstream": { "type": "object" },
    "debuggers": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" } },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "package": { "type": "string" },
        "filetypes": { "$ref": "#/$defs/strings" }, "adapter": { "type": "object" }, "configurations": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
