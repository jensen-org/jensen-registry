{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jensen-org/jensen-registry/tools/schema/entrypoints.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entrypoints"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "upstream": {
      "type": "object"
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "manifest",
          "format",
          "declarations",
          "implicit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "manifest": {
            "type": "string"
          },
          "format": {
            "enum": [
              "toml",
              "json",
              "yaml",
              "xml",
              "ruby",
              "gradle"
            ]
          },
          "declarations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "selector"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "binary",
                    "script",
                    "export",
                    "test_target",
                    "main"
                  ]
                },
                "selector": {
                  "type": "string"
                }
              }
            }
          },
          "implicit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
