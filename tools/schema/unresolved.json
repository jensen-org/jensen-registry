{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jensen-org/jensen-registry/tools/schema/unresolved.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "unresolved"],
  "properties": {
    "schema_version": { "const": 2 },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "missing"],
        "properties": {
          "kind": { "enum": ["server", "formatter", "linter", "debugger"] },
          "id": { "type": "string" },
          "missing": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    }
  }
}
