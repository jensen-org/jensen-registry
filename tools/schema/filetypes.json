{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jensen-org/jensen-registry/tools/schema/filetypes.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "upstream", "filetypes"],
  "properties": {
    "schema_version": { "const": 2 },
    "upstream": { "type": "object" },
    "filetypes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": { "id": { "type": "string" }, "related": { "type": "array", "items": { "type": "string" } }, "extensions": { "type": "array", "items": { "type": "string" } }, "filenames": { "type": "array", "items": { "type": "string" } } }
      }
    }
  }
}
