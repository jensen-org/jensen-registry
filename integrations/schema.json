{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jensen-org/jensen-registry/integrations/schema.json",
  "title": "Jensen registry integrations",
  "description": "Entry files under integrations/ and the integration items of index.yaml.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 80
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "hex": {
      "type": "string",
      "pattern": "^[0-9A-F]{6}$"
    },
    "integrationIcon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simple_icons": {
          "$ref": "#/$defs/slug"
        },
        "local": {
          "const": true
        },
        "hex": {
          "$ref": "#/$defs/hex"
        }
      },
      "oneOf": [
        {
          "required": [
            "simple_icons"
          ],
          "properties": {
            "local": false,
            "hex": false
          }
        },
        {
          "required": [
            "local",
            "hex"
          ],
          "properties": {
            "simple_icons": false
          }
        }
      ]
    },
    "integrationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "category",
        "icon",
        "auth",
        "advised"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "provider": {
          "type": "string"
        },
        "advised": {
          "type": "boolean"
        },
        "default_on": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z-]{0,39}$"
        },
        "icon": {
          "$ref": "#/$defs/integrationIcon"
        },
        "hosts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
          }
        },
        "native": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$"
        },
        "auth": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method"
            ],
            "properties": {
              "method": {
                "enum": [
                  "api_key",
                  "oauth",
                  "cli_login",
                  "none"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "fields": {
                "$ref": "https://github.com/jensen-org/jensen-registry/mcp/schema.json#/$defs/env"
              },
              "scopes": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9:_./-]{1,80}$"
                }
              }
            }
          }
        },
        "permissions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "label",
              "write"
            ],
            "properties": {
              "action": {
                "type": "string",
                "pattern": "^[a-z][a-z ]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "hint": {
                "type": "string",
                "maxLength": 200
              },
              "group": {
                "type": "string",
                "maxLength": 40
              },
              "write": {
                "type": "boolean"
              }
            }
          }
        },
        "default_mcp": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "indexIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "category",
        "advised",
        "auth",
        "permissions",
        "icon",
        "mcp"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "advised": {
          "type": "boolean"
        },
        "default_on": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native": {
          "type": "string"
        },
        "auth": {
          "type": "array"
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "default"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        "permissions": {
          "type": "array"
        },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "path",
            "url",
            "sha256",
            "size",
            "hex"
          ],
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^(simple-icons@[0-9][0-9A-Za-z.+-]*|local)$"
            },
            "path": {
              "type": "string",
              "pattern": "^integrations/icons/[a-z0-9][a-z0-9-]{0,63}\\.svg$"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000
            },
            "hex": {
              "$ref": "#/$defs/hex"
            }
          }
        },
        "default_mcp": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
