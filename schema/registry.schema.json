{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jensen-org/jensen-registry/schema/registry.schema.json",
  "title": "Jensen registry",
  "description": "Entry files under skills/ and mcp/, the generated index.yaml, and upstreams.yaml.",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 80 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "secret"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "secret": { "type": "boolean" },
          "optional": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "envName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "hex": { "type": "string", "pattern": "^[0-9A-F]{6}$" },
    "headers": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scheme", "secret"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$" },
          "scheme": { "enum": ["bearer", "basic", "raw"] },
          "secret": { "$ref": "#/$defs/envName" },
          "user": { "$ref": "#/$defs/envName" }
        }
      }
    },
    "integrationIcon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simple_icons": { "$ref": "#/$defs/slug" },
        "local": { "const": true },
        "hex": { "$ref": "#/$defs/hex" }
      },
      "oneOf": [
        { "required": ["simple_icons"], "properties": { "local": false, "hex": false } },
        { "required": ["local", "hex"], "properties": { "simple_icons": false } }
      ]
    },
    "integrationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "category", "icon", "auth", "advised"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 400 },
        "provider": { "type": "string" },
        "advised": { "type": "boolean" },
        "default_on": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string", "pattern": "^[a-z][a-z-]{0,39}$" },
        "icon": { "$ref": "#/$defs/integrationIcon" },
        "hosts": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$" }
        },
        "native": { "type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$" },
        "auth": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method"],
            "properties": {
              "method": { "enum": ["api_key", "oauth", "cli_login", "none"] },
              "label": { "type": "string", "maxLength": 80 },
              "fields": { "$ref": "#/$defs/env" },
              "scopes": {
                "type": "array",
                "maxItems": 32,
                "items": { "type": "string", "pattern": "^[A-Za-z0-9:_./-]{1,80}$" }
              }
            }
          }
        },
        "mcp": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "note": { "type": "string", "maxLength": 200 },
              "default": { "type": "boolean" }
            }
          }
        },
        "permissions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "label", "write"],
            "properties": {
              "action": { "type": "string", "pattern": "^[a-z][a-z ]{0,63}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "hint": { "type": "string", "maxLength": 200 },
              "group": { "type": "string", "maxLength": 40 },
              "write": { "type": "boolean" }
            }
          }
        }
      }
    },
    "indexIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "category", "advised", "auth", "mcp", "permissions", "icon"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "provider": { "type": "string" },
        "advised": { "type": "boolean" },
        "default_on": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "hosts": { "type": "array", "items": { "type": "string" } },
        "native": { "type": "string" },
        "auth": { "type": "array" },
        "mcp": { "type": "array" },
        "permissions": { "type": "array" },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "path", "url", "sha256", "size", "hex"],
          "properties": {
            "source": { "type": "string", "pattern": "^(simple-icons@[0-9][0-9A-Za-z.+-]*|local)$" },
            "path": { "type": "string", "pattern": "^icons/(local/)?[a-z0-9][a-z0-9-]{0,63}\\.svg$" },
            "url": { "type": "string", "pattern": "^https://" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "size": { "type": "integer", "minimum": 1, "maximum": 20000 },
            "hex": { "$ref": "#/$defs/hex" }
          }
        }
      }
    },
    "skillEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repo", "path", "ref", "advised"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "path": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "provider": { "type": "string" },
        "license": { "type": "string" },
        "advised": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "mcpEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "transport", "advised"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "provider": { "type": "string" },
        "license": { "type": "string" },
        "advised": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "transport": { "enum": ["stdio", "http"] },
        "url": { "type": "string", "pattern": "^https://" },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ecosystem", "name", "bin"],
          "properties": {
            "ecosystem": { "enum": ["npm", "pypi"] },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "pattern": "^[0-9][0-9A-Za-z.+-]*$" },
            "bin": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        },
        "env": { "$ref": "#/$defs/env" },
        "headers": { "$ref": "#/$defs/headers" },
        "oauth": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "transport": { "const": "stdio" } } }, "then": { "required": ["package"], "properties": { "url": false, "headers": false, "oauth": false } } },
        { "if": { "properties": { "transport": { "const": "http" } } }, "then": { "required": ["url"], "properties": { "package": false } } }
      ]
    },
    "indexSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "advised", "repo", "path", "ref", "commit", "content_hash", "files"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "provider": { "type": "string" },
        "license": { "type": "string" },
        "advised": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "repo": { "type": "string" },
        "path": { "type": "string" },
        "ref": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "url", "sha256", "size"],
            "properties": {
              "path": { "type": "string" },
              "url": { "type": "string", "pattern": "^https://" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "size": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "indexMcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "advised", "transport", "env", "tools"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "provider": { "type": "string" },
        "license": { "type": "string" },
        "advised": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "transport": { "enum": ["stdio", "http"] },
        "url": { "type": "string" },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ecosystem", "name", "version", "purl", "bin", "lockfile"],
          "properties": {
            "ecosystem": { "enum": ["npm", "pypi"] },
            "name": { "type": "string" },
            "version": { "type": "string" },
            "purl": { "type": "string", "pattern": "^pkg:(npm|pypi)/" },
            "bin": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "lockfile": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "url", "sha256"],
              "properties": {
                "path": { "type": "string" },
                "url": { "type": "string", "pattern": "^https://" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        },
        "env": { "$ref": "#/$defs/env" },
        "headers": { "$ref": "#/$defs/headers" },
        "oauth": { "type": "boolean" },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "input_schema": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
